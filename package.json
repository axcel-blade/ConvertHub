{
  "name": "converthub",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:version && npm run test:unit && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "cargo test --manifest-path src-tauri/Cargo.toml --lib e2e -- --ignored --test-threads=3",
    "lint": "biome lint src scripts",
    "test:unit": "vitest run",
    "check:version": "node scripts/version.mjs",
    "version:set": "node scripts/version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
