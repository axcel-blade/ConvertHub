{
  "name": "converthub",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "npm run typecheck && npm run check:i18n && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "cargo test --manifest-path src-tauri/Cargo.toml --lib e2e -- --ignored --test-threads=3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
